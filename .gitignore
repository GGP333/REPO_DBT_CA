# .gitignore for Repo_DBT_CA (manuscript support repo)
# Heavy/derived artifacts are already physically excluded from this repo.
# Curated results (figures, metrics, training logs) ARE versioned on purpose.

# Python caches
__pycache__/
*.py[cod]
*$py.class
*.so

# Virtual environments
venv/
env/
ENV/
.venv/

# IDEs / OS
.vscode/
.idea/
*.swp
*~
.DS_Store

# Jupyter
.ipynb_checkpoints/

# Material not used in the manuscript (kept locally only, not versioned)
_descartado/
ENSEMBLE_METHODOLOGY.md

# Compiled PDFs and LaTeX build artifacts (regenerable from the .tex sources;
# note: *.log is intentionally NOT ignored below, it holds training logs)
*.pdf
*.aux
*.out
*.toc
*.synctex.gz
*.fls
*.fdb_latexmk
*.bbl
*.blg

# --- Heavy artifacts: never commit ---
# Model weights
*.pt
*.pth
*.ckpt
checkpoints/
# Raw prediction arrays / tensors
*.npy
*.npz
# Raw imaging data
*.tif
*.tiff
Dataset/
Dataset_Preprocessed/
data/raw/
data/preprocessed/
# Archives
*.zip
*.tar
*.tar.gz

# nnU-Net heavy internals (keep only light configs + training_log*.txt)
**/nnunet_root/raw/
**/nnunet_root/preprocessed/
**/eval/predictions/

# NOTE: *.png, *.log, *.txt, *.csv, *.json are intentionally NOT ignored —
# they hold the curated metrics, training curves, sample figures and training logs.

# --- Revision material ---
# Reviewer material and written reports: kept locally only, never committed.
# Reviewer comments, response to reviewers, manuscript patches, the Spanish
# reports and the slide deck all live under this folder and stay off GitHub.
revision_privada/
Ablationstudy_test_statdistico/

# LaTeX build artefacts
docs/*.aux
docs/*.log
docs/*.out
docs/*.toc
docs/*.fls
docs/*.fdb_latexmk
docs/*.nav
docs/*.snm

# Figure PDFs ARE tracked: they are the vector version of the tracked PNGs and
# the manuscript needs them. Written documents in PDF are not (rule above).
!docs/figures/*.pdf
!results/**/fig_*.pdf
# Las tablas del manuscrito se publican tambien en PDF recortado, para poder
# mirarlas sin compilar el manuscrito. Las emite su propio generador.
!docs/tables/manuscrito/*.pdf

# --- Kept local: training by-products and report-only material ---
# Sample dumps and learning curves emitted during training. They are useful
# locally but they are not manuscript figures, and 123 of them buried the
# figures that matter. The paper figures under paper_assets ARE tracked.
results/outputs_*/*/samples/
results/outputs_*/*/logs/*.png
results/finetuning_logs/*/*/*.png
results/figures/

# Table bodies and generators that only feed the Spanish reports, which are
# not published here. The manuscript tables and their generator stay tracked.
docs/tables/analisis/
docs/tables/detalle/
docs/make_latex_tables.py
docs/make_report_tables.py
